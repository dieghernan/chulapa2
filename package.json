{
  "name": "chulapa2",
  "private": true,
  "scripts": {
    "build": "bundle exec jekyll build",
    "preview": "bundle exec jekyll serve",
    "build:test": "bundle exec jekyll build --config _config.yml,test/_config.yml --drafts --unpublished --baseurl /chulapa2 --destination _site_test",
    "build:test:themed": "bundle exec jekyll build --config _config.yml,test/_themed.yml --baseurl /chulapa2/test/themed --destination _site_test/test/themed",
    "preview:test": "npm run build:test && npm run build:test:themed && bundle exec jekyll serve --skip-initial-build --no-watch --host 127.0.0.1 --port 4173 --baseurl /chulapa2 --destination _site_test",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
